# GroundCheck — environment variables
# Copy this file to .env and fill in real values. Never commit .env.

# PostgreSQL connection string — required by @workspace/db and drizzle-kit
DATABASE_URL=postgresql://user:password@localhost:5432/groundcheck

# HTTP port the API server listens on — injected automatically by Replit
PORT=8080

# Secret used to sign/verify Express sessions — use a long random string
SESSION_SECRET=change-me-to-a-long-random-string

# Minimum log level for the API server (trace | debug | info | warn | error | fatal)
LOG_LEVEL=info

# Runtime environment — controls optimisations and error verbosity
NODE_ENV=development
